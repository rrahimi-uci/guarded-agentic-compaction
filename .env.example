# Required only for provider-backed demonstrations.
OPENAI_API_KEY=

# Required only for online SEC acquisition. Use a genuine project/entity name
# and contact address; never commit a personal value.
SEC_USER_AGENT=

# Optional for the legacy live demo. The multidomain runner ignores this value,
# requires --model explicitly, and never infers spending authorization from it.
AGENT_COMPACTION_LIVE_MODEL=
