{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-compaction.dev/schemas/pricing.schema.json",
  "title": "Pinned provider pricing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model",
    "input_usd_per_million",
    "cached_input_usd_per_million",
    "output_usd_per_million",
    "maximum_billable_input_tokens_per_request",
    "output_token_limit_per_request",
    "service_tier",
    "revision",
    "source_url",
    "retrieved_at"
  ],
  "properties": {
    "schema": {
      "const": "agent-compaction-pricing/v1"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "input_usd_per_million": {
      "type": "number",
      "minimum": 0
    },
    "cached_input_usd_per_million": {
      "type": "number",
      "minimum": 0
    },
    "output_usd_per_million": {
      "type": "number",
      "minimum": 0
    },
    "maximum_billable_input_tokens_per_request": {
      "type": "integer",
      "minimum": 1
    },
    "output_token_limit_per_request": {
      "type": "integer",
      "minimum": 1
    },
    "service_tier": {
      "enum": ["auto", "default", "flex", "priority"]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
